# ECG Telemetry Arrhythmia Agent - Environment Configuration
# Copy this file to .env and set your own values

# Required: Secret key for HMAC-SHA256 audit trail signing
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=your-secure-audit-secret-key-here

# Optional: LLM provider (mock, ollama, claude, openai)
MODEL_PROVIDER=mock
